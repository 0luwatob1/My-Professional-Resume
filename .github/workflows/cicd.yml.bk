name: My first pipeline

on:
    push:
        branches: ["main"]

jobs:
    build:
        runs-on: ubuntu-latest # macos, windows-latest
        steps:
            - name: Checkout the code
              uses: actions/checkout@v4
            - name: Build image
              run:
                docker build -t oluwatobiyh2/cicd-portfollio .
            - name: Docker login
              uses: docker/login-action@v3
              with:
                username: oluwatobiyh2
                password: ${{ secrets.DOCKER_PASSWD }}
            - name: Push image
              run:
                docker push oluwatobiyh2/cicd-portfollio
                